@inherits LayoutComponentBase

@* Estructura semántica: aside para la navegación lateral, main para el
   contenido propio de cada página y footer como pie del sitio, fuera de main
   porque no forma parte del contenido de la página.
   El div "columna" no tiene significado: solo agrupa main y footer para que,
   en escritorio, queden en una misma columna a la derecha del menú. *@
<div class="page">
    <aside class="sidebar">
        <NavMenu />
    </aside>

    <div class="columna">
        <main class="content px-4">
            @Body
        </main>

        @* Solo se enlazan rutas que existen. Nada de secciones inventadas. *@
        <footer class="pie">
            <div class="pie-contenido">
                <div>
                    <p class="pie-logo">Indumentaria</p>
                    <p class="pie-bajada">Ropa urbana para todos los días.</p>
                </div>

                <nav class="pie-nav" aria-label="Enlaces del pie">
                    <p class="pie-titulo">Navegación</p>
                    <a href="/">Inicio</a>
                    <a href="catalogo">Catálogo</a>
                    <a href="carrito">Carrito</a>
                    <a href="admin/productos">Administración</a>
                </nav>
            </div>

            <div class="pie-legal">
                <span>© @DateTime.Now.Year Indumentaria</span>
                <span>Proyecto integrador · Blazor Server · .NET 9</span>
            </div>
        </footer>
    </div>
</div>

@* Cartel que Blazor muestra si se corta el circuito o se produce un error
   no controlado del lado del servidor. *@
<div id="blazor-error-ui" data-nosnippet>
    Se produjo un error inesperado.
    <a href="." class="reload">Recargar</a>
    <span class="dismiss">🗙</span>
</div>
