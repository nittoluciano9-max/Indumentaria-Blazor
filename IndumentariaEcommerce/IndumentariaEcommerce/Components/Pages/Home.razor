@page "/"
@inject ProductoService ProductoService

<PageTitle>Indumentaria - Inicio</PageTitle>

<section class="portada mb-5">
    <p class="rotulo mb-2">Temporada 2026</p>
    <h1 class="mb-3">Ropa para todos los días</h1>
    <p class="lead mb-4">
        Remeras, pantalones, camperas, vestidos y calzado.
        Para hombre, para mujer y unisex.
    </p>
    <a href="/catalogo" class="btn btn-primary btn-lg">Ver el catálogo</a>
</section>

<section>
    <div class="encabezado-seccion d-flex justify-content-between align-items-baseline mb-4">
        <h2 class="h4 mb-0">Destacados</h2>
        <a href="/catalogo" class="text-decoration-none">Ver todo el catálogo</a>
    </div>

    @if (destacados is null)
    {
        <Cargando />
    }
    else
    {
        @* Se reutiliza la misma tarjeta del catálogo. Este es el segundo uso
           que justificó extraerla a un componente en lugar de dejarla dentro
           del foreach de Catalogo.razor. *@
        <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-4 g-4">
            @foreach (var producto in destacados)
            {
                <div class="col" @key="producto.Id">
                    <TarjetaProducto Producto="producto" />
                </div>
            }
        </div>
    }
</section>

@code {
    private List<Producto>? destacados;

    protected override async Task OnInitializedAsync()
    {
        destacados = await ProductoService.ObtenerDestacadosAsync();
    }
}
