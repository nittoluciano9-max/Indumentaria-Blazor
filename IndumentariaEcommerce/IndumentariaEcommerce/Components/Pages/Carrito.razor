@* Página del carrito.
   No se suscribe al evento OnCambio del servicio, a diferencia de
   IconoCarrito: acá los cambios los origina esta misma página, y Blazor
   redibuja solo cuando termina un manejador de @onclick. Suscribirse sería
   código que no agrega nada. *@

@page "/carrito"
@inject CarritoService ServicioCarrito

<PageTitle>Carrito - Indumentaria</PageTitle>

<h1 class="mb-4">Tu carrito</h1>

@if (ServicioCarrito.EstaVacio)
{
    <div class="text-center py-5">
        <p class="text-muted fs-5">Todavía no agregaste productos.</p>
        <a href="/catalogo" class="btn btn-primary">Ir al catálogo</a>
    </div>
}
else
{
    <div class="row g-4">

        <div class="col-12 col-lg-8">
            @foreach (var item in ServicioCarrito.Items)
            {
                @* Clave compuesta: una línea del carrito se identifica por el
                   par producto + talle, no por el producto solo. *@
                <div class="card mb-3" @key="(item.ProductoId, item.Talle)">
                    <div class="row g-0">

                        <div class="col-4 col-sm-3">
                            <div class="miniatura">
                                <img src="@item.ImagenUrl"
                                     alt="@item.Nombre"
                                     onerror="this.onerror=null; this.src='/imagenes/sin-imagen.svg';" />
                            </div>
                        </div>

                        <div class="col-8 col-sm-9">
                            <div class="card-body py-2">

                                <div class="d-flex justify-content-between align-items-start">
                                    <div>
                                        <a href="/producto/@item.ProductoId"
                                           class="text-decoration-none text-reset">
                                            <h6 class="mb-1">@item.Nombre</h6>
                                        </a>
                                        <p class="rotulo mb-2">
                                            Talle @item.Talle ·
                                            @item.PrecioUnitario.ToString("C0") c/u
                                        </p>
                                    </div>

                                    <button type="button"
                                            class="btn btn-sm btn-outline-danger"
                                            title="Quitar del carrito"
                                            aria-label="Quitar @item.Nombre del carrito"
                                            @onclick="() => ServicioCarrito.QuitarAsync(item.ProductoId, item.Talle)">
                                        X
                                    </button>
                                </div>

                                <div class="d-flex justify-content-between align-items-center">
                                    <div class="btn-group btn-group-sm" role="group"
                                         aria-label="Cantidad de @item.Nombre">
                                        <button type="button"
                                                class="btn btn-outline-secondary"
                                                @onclick="() => CambiarCantidadAsync(item, item.Cantidad - 1)">
                                            -
                                        </button>
                                        <span class="btn btn-outline-secondary disabled cantidad">
                                            @item.Cantidad
                                        </span>
                                        <button type="button"
                                                class="btn btn-outline-secondary"
                                                @onclick="() => CambiarCantidadAsync(item, item.Cantidad + 1)">
                                            +
                                        </button>
                                    </div>

                                    <span class="subtotal">@item.Subtotal.ToString("C0")</span>
                                </div>

                            </div>
                        </div>

                    </div>
                </div>
            }
        </div>

        <div class="col-12 col-lg-4">
            <div class="card resumen">
                <div class="card-body">
                    <h5 class="card-title mb-3">Resumen</h5>

                    <div class="d-flex justify-content-between text-muted">
                        <span>Artículos</span>
                        <span>@ServicioCarrito.CantidadTotal</span>
                    </div>

                    <hr />

                    <div class="d-flex justify-content-between total">
                        <span>Total</span>
                        <span>@ServicioCarrito.Total.ToString("C0")</span>
                    </div>

                    <a href="/catalogo" class="btn btn-outline-primary w-100 mt-3">
                        Seguir comprando
                    </a>

                    <button type="button"
                            class="btn btn-link text-danger w-100 mt-1"
                            @onclick="ServicioCarrito.VaciarAsync">
                        Vaciar carrito
                    </button>
                </div>
            </div>
        </div>

    </div>
}

@code {
    /// <summary>
    /// Una cantidad de cero o menos equivale a quitar el item: de eso ya se
    /// encarga el servicio, acá solo se le pasa el número.
    /// </summary>
    private Task CambiarCantidadAsync(ItemCarrito item, int nuevaCantidad) =>
        ServicioCarrito.CambiarCantidadAsync(item.ProductoId, item.Talle, nuevaCantidad);
}
