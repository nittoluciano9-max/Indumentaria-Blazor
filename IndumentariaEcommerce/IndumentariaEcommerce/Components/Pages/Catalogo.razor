@page "/catalogo"
@inject ProductoService ProductoService

<PageTitle>Catálogo - Indumentaria</PageTitle>

<h1 class="mb-4">Catálogo</h1>

@* El catálogo no sabe cómo está hecho el filtro por dentro: solo recibe un
   FiltrosCatalogo cada vez que el usuario cambia algo. *@
<FiltroProductos OnCambio="AplicarFiltrosAsync" />

@if (resultado is null)
{
    <!-- Blazor dibuja el componente ANTES de que OnInitializedAsync termine,
         así que en el primer render "resultado" todavía es null. -->
    <div class="d-flex align-items-center gap-2 text-muted">
        <div class="spinner-border spinner-border-sm" role="status"></div>
        <span>Cargando productos...</span>
    </div>
}
else if (resultado.Items.Count == 0)
{
    <div class="alert alert-info">
        No se encontraron productos con los filtros seleccionados.
    </div>
}
else
{
    <p class="text-muted">@resultado.TotalItems productos encontrados.</p>

    <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 row-cols-xl-4 g-4">
        @foreach (var producto in resultado.Items)
        {
            @* @key identifica cada elemento por su Id. Sin esto Blazor compara
               la lista por posición al re-renderizar, y al cambiar el filtro
               podría reutilizar el nodo de un producto para mostrar otro. *@
            <div class="col" @key="producto.Id">
                <TarjetaProducto Producto="producto" />
            </div>
        }
    </div>
}

@code {
    // Nullable a propósito: null significa "todavía no llegó la consulta".
    private ResultadoPaginado<Producto>? resultado;

    private FiltrosCatalogo filtros = FiltrosCatalogo.Vacio;

    protected override Task OnInitializedAsync() => CargarAsync();

    /// <summary>
    /// Corre cuando FiltroProductos avisa que el usuario cambió algo.
    /// </summary>
    private Task AplicarFiltrosAsync(FiltrosCatalogo nuevosFiltros)
    {
        filtros = nuevosFiltros;
        return CargarAsync();
    }

    private async Task CargarAsync()
    {
        resultado = await ProductoService.BuscarAsync(
            filtros.Genero,
            filtros.CategoriaId,
            filtros.Texto);
    }
}
